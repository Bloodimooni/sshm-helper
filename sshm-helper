#!/usr/bin/env bash
# sshm-helper: import hosts into the ssh config used by sshm and sort them into
# per-cluster config files.
# sshm reads ~/.ssh/config and stores tags as a "# Tags: a, b" comment
# directly above each Host block, so entries are written in that format.

set -euo pipefail

usage() {
    cat >&2 <<EOF
Usage:
  $(basename "$0") import       <file> [tag1,tag2,...] [ssh_config]
  $(basename "$0") move-cluster [cluster[,cluster...]] [ssh_config]
  $(basename "$0") include      [on|off] [ssh_config]

import        append hosts to ssh_config. <file> is either a Tarook/Ansible inventory
              (hosts.yaml) or an ssh_known_hosts file with @cert-authority lines; the
              type is detected automatically. Without tags you are asked whether to
              set some, afterwards whether to move the new clusters into own files.
move-cluster  move all hosts of a cluster (host name minus "-<role>-<index>") into
              sshm/config_<cluster> next to ssh_config. The file is not included
              from ssh_config, open it with "sshm -c <file>". Without cluster
              names a table is shown to pick from (fzf, TAB to multi-select).
include       include all sshm/config_* files from ssh_config (on), or not (off,
              the default). Without on/off the current state is toggled.

ssh_config defaults to ~/.ssh/config. import backs it up to sshm/backups next
to it first; the newest 7 backups are kept.
EOF
    exit 1
}

# Cluster configs and backups live in sshm/ next to the ssh config
sshm_dir() {
    echo "$(cd "$(dirname "$1")" && pwd)/sshm"
}

# Backup before importing; only the newest 7 backups are kept
backup() {
    local dir name file old
    dir="$(sshm_dir "$1")/backups"
    name="$(basename "$1")"
    mkdir -p "$dir"
    chmod 700 "$(dirname "$dir")" "$dir"
    # never overwrite: two runs in the same second keep the older state
    file="$dir/$name.bak.$(date +%Y%m%d%H%M%S)"
    [[ -e "$file" ]] || cp "$1" "$file"

    # timestamps sort chronologically, so everything but the last 7 is old
    shopt -s nullglob
    old=("$dir/$name".bak.*)
    shopt -u nullglob
    if [[ ${#old[@]} -gt 7 ]]; then
        rm -f -- "${old[@]:0:${#old[@]}-7}"
    fi
}

import_hosts() {
    local src="$1" tags_raw="$2" ssh_config="$3" parser

    [[ -r "$src" ]] || { echo "error: cannot read $src" >&2; exit 1; }

    if grep -q '^@cert-authority[[:space:]]' "$src"; then
        echo "detected: ssh_known_hosts"
        parser="$known_hosts_parser"
    elif grep -q '^      local_ipv4_address:' "$src"; then
        echo "detected: inventory"
        parser="$inventory_parser"
    else
        echo "error: $src is neither an inventory (local_ipv4_address) nor an ssh_known_hosts file (@cert-authority)" >&2
        exit 1
    fi

    if [[ -z "$tags_raw" ]]; then
        read -r -p "Set tags? [y/N] " answer || true
        if [[ "$answer" =~ ^[Yy] ]]; then
            read -r -p "Tags (comma-separated): " tags_raw || true
        fi
    fi

    # "cah,cluster-demo-1" -> "cah, cluster-demo-1" (format sshm writes)
    local tags
    tags="$(sed -E 's/[[:space:]]*,[[:space:]]*/, /g; s/^[[:space:]]+|[[:space:]]+$//g' <<<"$tags_raw")"

    mkdir -p "$(dirname "$ssh_config")"
    touch "$ssh_config"
    chmod 600 "$ssh_config"
    backup "$ssh_config"

    # hosts already moved into config_<cluster> files count as present too
    local existing=("$ssh_config")
    shopt -s nullglob
    existing+=("$(sshm_dir "$ssh_config")"/config_*)
    shopt -u nullglob

    local added=0 skipped=0 host ip new_hosts=()
    while read -r host ip; do
        [[ -z "$host" || -z "$ip" ]] && continue

        if grep -qE "^[[:space:]]*Host[[:space:]]+(.*[[:space:]])?${host//./\\.}([[:space:]]|$)" "${existing[@]}"; then
            echo "skip: $host already in $ssh_config"
            skipped=$((skipped + 1))
            continue
        fi

        {
            # blank separator line if file is non-empty and doesn't end with one
            if [[ -s "$ssh_config" && -n "$(tail -n1 "$ssh_config")" ]]; then
                echo
            fi
            [[ -n "$tags" ]] && echo "# Tags: $tags"
            echo "Host $host"
            echo "    HostName $ip"
        } >>"$ssh_config"

        echo "add:  $host -> $ip"
        new_hosts+=("$host")
        added=$((added + 1))
    done < <(awk "$parser" "$src")

    echo "done: $added added, $skipped skipped ($ssh_config)"

    [[ $added -gt 0 ]] || return 0
    local clusters
    clusters="$(printf '%s\n' "${new_hosts[@]}" | awk "$cluster_fn"'{ c = cluster($1) } c != "" && !seen[c]++ { print c }' | paste -sd,)"
    [[ -n "$clusters" ]] || return 0

    read -r -p "Move clusters into own config files (${clusters//,/, })? [y/N] " answer || true
    [[ "$answer" =~ ^[Yy] ]] && move_cluster "$clusters" "$ssh_config"
    return 0
}

# Tarook/Ansible YAML inventory: host keys sit at 4-space indent under <group>.hosts
inventory_parser='
    /^    [^ #][^ ]*: *$/ { h = $1; sub(/:$/, "", h); next }
    /^      local_ipv4_address:/ { print h, $2 }
'

# "@cert-authority name,ip1,ip2 keytype key" -> "name ip1"
known_hosts_parser='
    $1 == "@cert-authority" { n = split($2, f, ","); if (n >= 2) print f[1], f[2] }
'

# host name -> cluster name ("" if it doesn't look like one),
# e.g. k8s-cloud-svcs-test-gw-0 -> k8s-cloud-svcs-test
cluster_fn='function cluster(h) { return match(h, /-[[:alpha:]]+-[[:alnum:]]+$/) ? substr(h, 1, RSTART - 1) : "" }'

move_cluster() {
    local clusters_raw="$1" ssh_config="$2"

    [[ -r "$ssh_config" ]] || { echo "error: cannot read $ssh_config" >&2; exit 1; }

    local config_dir
    config_dir="$(cd "$(dirname "$ssh_config")" && pwd)"

    if [[ -z "$clusters_raw" ]]; then
        command -v fzf >/dev/null || { echo "error: fzf needed for the selection table (or pass cluster names)" >&2; exit 1; }

        # cluster <TAB> host count <TAB> tags
        local table selection
        table="$(awk "$cluster_fn"'
            /^# Tags:/ { tags = $0; sub(/^# Tags:[[:space:]]*/, "", tags); next }
            /^[[:space:]]*Host[[:space:]]/ {
                c = cluster($2)
                if (c != "") { n[c]++; if (!(c in t)) t[c] = tags }
                tags = ""; next
            }
            { tags = "" }
            END { for (c in n) printf "%s\t%d\t%s\n", c, n[c], t[c] }
        ' "$ssh_config" | sort)"

        [[ -n "$table" ]] || { echo "no clusters found in $ssh_config"; exit 0; }

        selection="$( (printf 'CLUSTER\tHOSTS\tTAGS\n'; echo "$table") | column -t -s $'\t' |
            fzf --multi --header-lines=1 --layout=reverse --height=~50% \
                --prompt="cluster> " --header="TAB: select multiple, ENTER: move" )" || exit 0
        clusters_raw="$(awk '{ print $1 }' <<<"$selection" | paste -sd,)"
    fi

    mkdir -p "$config_dir/sshm"
    chmod 700 "$config_dir/sshm"

    local clusters c target tmp moved inc
    IFS=',' read -r -a clusters <<<"$clusters_raw"
    for c in "${clusters[@]}"; do
        c="$(xargs <<<"$c")"
        [[ -z "$c" ]] && continue

        target="$config_dir/sshm/config_$c"
        tmp="$(mktemp "$config_dir/.config.XXXXXX")"
        touch "$target"
        chmod 600 "$target"

        # Split the config: blocks of cluster $c (with the comments directly above
        # their Host line) are appended to $target, everything else goes to $tmp.
        moved="$(awk -v sel="$c" -v out="$target" -v has_out="$([[ -s "$target" ]] && echo 1 || echo 0)" "$cluster_fn"'
            # blank lines are held back so none are left dangling at the start or end
            function keep(s) { if (blank && printed) print ""; blank = 0; printed = 1; print s }
            function flush() { if (pend != "") keep(substr(pend, 1, length(pend) - 1)); pend = "" }
            /^[[:space:]]*Host[[:space:]]/ {
                mv = (cluster($2) == sel); in_block = 1
                if (mv) {
                    if (has_out) print "" >> out
                    printf "%s%s\n", pend, $0 >> out
                    has_out = 1; pend = ""; count++
                } else { flush(); keep($0) }
                next
            }
            /^[[:space:]]*$/ {
                flush()
                if (!(in_block && mv)) blank = 1    # drop the separator after a moved block
                in_block = 0; next
            }
            /^#/ { in_block = 0; pend = pend $0 "\n"; next }
            /^[[:space:]]/ && in_block { if (mv) print >> out; else keep($0); next }
            { flush(); in_block = 0; keep($0) }
            END { flush(); print count + 0 > "/dev/stderr" }
        ' "$ssh_config" 2>&1 >"$tmp")"

        if [[ "$moved" -eq 0 ]]; then
            echo "skip: no hosts for cluster $c"
            rm -f "$tmp"
            [[ -s "$target" ]] || rm -f "$target"
            continue
        fi

        # Deliberately no Include: the cluster stays out of the default sshm view
        # and is opened with "sshm -c <file>".
        chmod 600 "$tmp"
        mv "$tmp" "$ssh_config"
        echo "move: $moved hosts of $c -> $target (open with: sshm -c ${target/#$HOME/\~})"
    done

    echo "done"
}

# Add or remove a single "Include sshm/config_*" line at the top of ssh_config
toggle_include() {
    local mode="$1" ssh_config="$2" config_dir inc

    [[ -r "$ssh_config" ]] || { echo "error: cannot read $ssh_config" >&2; exit 1; }
    config_dir="$(cd "$(dirname "$ssh_config")" && pwd)"

    # Relative paths in Include are resolved against ~/.ssh.
    if [[ "$config_dir" == "$HOME/.ssh" ]]; then inc="Include sshm/config_*"; else inc="Include $config_dir/sshm/config_*"; fi

    local present=off
    grep -qxF "$inc" "$ssh_config" && present=on
    if [[ -z "$mode" ]]; then
        [[ "$present" == on ]] && mode=off || mode=on
    fi
    [[ "$mode" == "$present" ]] && { echo "include already $mode"; return 0; }

    local tmp
    tmp="$(mktemp "$config_dir/.config.XXXXXX")"
    if [[ "$mode" == on ]]; then
        # must come before any Host block, otherwise it only applies inside it
        { echo "$inc"; [[ -s "$ssh_config" && -n "$(head -n1 "$ssh_config")" ]] && echo; cat "$ssh_config"; } >"$tmp"
    else
        # drop the line and the blank separator right after it
        awk -v inc="$inc" '$0 == inc { skip = 1; next } skip && /^$/ { skip = 0; next } { skip = 0; print }' "$ssh_config" >"$tmp"
    fi
    chmod 600 "$tmp"
    mv "$tmp" "$ssh_config"
    echo "include $mode: $inc"
}

[[ $# -ge 1 ]] || usage
cmd="$1"; shift

case "$cmd" in
    import)
        [[ $# -lt 1 || $# -gt 3 ]] && usage
        import_hosts "$1" "${2:-}" "${3:-$HOME/.ssh/config}"
        ;;
    move-cluster)
        [[ $# -gt 2 ]] && usage
        move_cluster "${1:-}" "${2:-$HOME/.ssh/config}"
        ;;
    include)
        mode=""
        [[ "${1:-}" == on || "${1:-}" == off ]] && { mode="$1"; shift; }
        [[ $# -gt 1 ]] && usage
        toggle_include "$mode" "${1:-$HOME/.ssh/config}"
        ;;
    *) usage ;;
esac
